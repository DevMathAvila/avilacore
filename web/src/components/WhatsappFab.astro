---
// Botão flutuante de WhatsApp — sempre presente
const phone = '5519993808005';
const msg = encodeURIComponent('Olá, Matheus! Vim pelo seu site e queria conversar sobre um projeto.');
const href = `https://wa.me/${phone}?text=${msg}`;
---

<a
  class="wa-fab"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="Conversar no WhatsApp"
>
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
    <path
      fill="currentColor"
      d="M16.04 4C9.93 4 4.98 8.95 4.98 15.06c0 1.95.51 3.86 1.48 5.54L4 28l7.6-1.99a11.05 11.05 0 0 0 4.44.93h.01c6.11 0 11.06-4.95 11.06-11.06C27.11 8.95 22.15 4 16.04 4Zm0 20.16h-.01a9.1 9.1 0 0 1-4.63-1.27l-.33-.2-3.5.92.93-3.42-.22-.35a9.06 9.06 0 0 1-1.39-4.83c0-5.02 4.08-9.1 9.1-9.1 2.43 0 4.71.95 6.43 2.67a9.05 9.05 0 0 1 2.66 6.44c0 5.01-4.08 9.1-9.13 9.1Zm5-6.81c-.27-.14-1.62-.8-1.87-.89-.25-.09-.43-.14-.62.14-.18.27-.71.89-.87 1.07-.16.18-.32.2-.59.07-.27-.14-1.16-.43-2.2-1.36-.81-.72-1.36-1.62-1.52-1.89-.16-.27-.02-.42.12-.55.12-.12.27-.32.41-.48.14-.16.18-.27.27-.46.09-.18.05-.34-.02-.48-.07-.14-.62-1.49-.85-2.04-.22-.53-.45-.46-.62-.47l-.53-.01c-.18 0-.48.07-.73.34-.25.27-.96.94-.96 2.29 0 1.35.98 2.65 1.12 2.84.14.18 1.93 2.95 4.68 4.14.65.28 1.16.45 1.56.58.66.21 1.25.18 1.72.11.53-.08 1.62-.66 1.85-1.3.23-.64.23-1.19.16-1.3-.07-.12-.25-.19-.52-.32Z"
    ></path>
  </svg>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: clamp(1rem, 4vw, 2rem);
    bottom: clamp(1rem, 4vw, 2rem);
    z-index: 90;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--whatsapp);
    color: #fff;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
    transition: opacity 0.25s var(--ease);
  }
  .wa-fab:hover {
    opacity: 0.9;
  }
</style>
