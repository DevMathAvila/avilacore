---
/**
 * Sites: a única frente com material para mostrar hoje, então a página abre
 * com os estudos autorais e só depois explica o serviço.
 */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TopoPagina from '../components/TopoPagina.astro';
import ListaItens from '../components/ListaItens.astro';
import Processo from '../components/Processo.astro';
import Duvidas from '../components/Duvidas.astro';
import CartaoTrabalho from '../components/CartaoTrabalho.astro';
import Fechamento from '../components/Fechamento.astro';
import { frentes, linkWhatsapp } from '../config/site';
import { servicoDa, trabalhosPublicados, guiasPublicados, depoimentosAutorizados, dataISO } from '../lib/conteudo';
import { servico as schemaServico, faq } from '../lib/schema';

const s = await servicoDa('sites');
const { Content } = await render(s);
const d = s.data;
const trabalhos = await trabalhosPublicados('sites');
const soEstudos = trabalhos.every((t) => t.data.tipo === 'estudo');
const depoimentos = await Promise.all(
  (await depoimentosAutorizados('sites')).map(async (dep) => ({ dep, Texto: (await render(dep)).Content })),
);
const guia = (await guiasPublicados()).find((g) => g.data.frente === 'sites');
const migalhas = [{ nome: d.nome, caminho: '/sites' }];
const confirmados = d.itens.filter((i) => i.confirmado).map((i) => i.nome);

const todoSite = [
  'Leve, feito para abrir rápido no celular.',
  'Contato a um toque: o WhatsApp e o formulário ficam sempre à mão.',
  'Títulos, descrições, dados estruturados e mapa do site prontos para o Google.',
  'Desenho próprio, feito para aquele negócio, sem modelo pronto.',
];
---

<Base
  titulo={d.seo.title}
  descricao={d.seo.description}
  atualizado={dataISO(d.atualizado)}
  migalhas={migalhas}
  schema={[
    schemaServico({ frente: 'sites', tipo: d.tipoServico, descricao: d.seo.description, itens: confirmados }),
    faq('/sites', d.duvidas),
  ]}
>
  <TopoPagina titulo={d.titulo} lead={d.lead} migalhas={migalhas}>
    <a class="botao botao--acao" href={linkWhatsapp(frentes.sites.whatsapp)} rel="noopener">Falar no WhatsApp</a>
    <a class="link" href="/contato?tipo=site">Escrever pelo formulário</a>
  </TopoPagina>

  {
    trabalhos.length > 0 && (
      <section class="vitrine" aria-labelledby="t-vitrine">
        <div class="grade">
          <h2 id="t-vitrine">{soEstudos ? 'Estudos autorais' : 'Sites que eu fiz'}</h2>
          {soEstudos && (
            <p class="eixo-b apoio vitrine__nota">
              Sites que criei para marcas fictícias, cada um para um tipo de negócio. Servem para
              você ver como eu trabalho antes de conversar.
            </p>
          )}
        </div>
        <div class="grade vitrine__lista">
          {trabalhos.map((t, i) => (
            <CartaoTrabalho trabalho={t} nivel="h3" prioridade={i === 0} sizes="(min-width: 60rem) 45vw, 92vw" />
          ))}
        </div>
      </section>
    )
  }

  <section class="secao">
    <div class="grade bloco">
      <h2>O que um site faz pelo seu negócio</h2>
      <div class="bloco__corpo prosa"><Content /></div>
    </div>
  </section>

  <section class="secao">
    <div class="grade bloco">
      <h2>O que eu faço</h2>
      <div class="bloco__corpo"><ListaItens itens={d.itens} /></div>
    </div>
  </section>

  <section class="secao">
    <div class="grade bloco">
      <h2>O que todo site meu tem</h2>
      <ul class="bloco__corpo lista-linhas">
        {todoSite.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="secao">
    <div class="grade bloco">
      <h2>Para quem</h2>
      <ul class="bloco__corpo lista-linhas">
        {d.paraQuem.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="secao">
    <div class="grade">
      <h2>Como funciona um site</h2>
      <div class="passos-pagina"><Processo passos={d.processo} /></div>
    </div>
  </section>

  {
    depoimentos.length > 0 && (
      <section class="secao">
        <div class="grade bloco">
          <h2>O que disseram</h2>
          <div class="bloco__corpo depoimentos">
            {depoimentos.map(({ dep, Texto }) => (
              <figure>
                <blockquote><Texto /></blockquote>
                <figcaption>
                  {dep.data.foto && <Image src={dep.data.foto} alt="" width={56} height={56} loading="lazy" />}
                  <span>
                    <strong>{dep.data.nome}</strong>
                    <span class="apoio pequeno">{dep.data.papel}</span>
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="secao">
    <div class="grade bloco">
      <h2>Dúvidas</h2>
      <div class="bloco__corpo"><Duvidas itens={d.duvidas} /></div>
    </div>
  </section>

  <Fechamento titulo={d.fechamento} mensagem={frentes.sites.whatsapp} tipo="site" />

  {
    guia && (
      <p class="grade guia-relacionado">
        <a class="link" href={`/guias/${guia.id}`}>Guia: {guia.data.titulo}</a>
      </p>
    )
  }
</Base>

<style>
  .vitrine {
    padding-bottom: var(--espaco-2xl);
  }
  .vitrine h2 {
    font-size: var(--passo-2);
  }
  .vitrine__nota {
    margin-top: var(--espaco-2xs);
  }
  .vitrine__lista {
    margin-top: var(--espaco-l);
    row-gap: var(--espaco-xl);
  }
  .passos-pagina {
    margin-top: var(--espaco-l);
  }
  .depoimentos {
    display: grid;
    gap: var(--espaco-l);
  }
  .depoimentos blockquote {
    font-size: var(--passo-1);
    line-height: 1.45;
  }
  .depoimentos figcaption {
    display: flex;
    align-items: center;
    gap: var(--espaco-xs);
    margin-top: var(--espaco-s);
  }
  .depoimentos figcaption img {
    border-radius: 50%;
  }
  .depoimentos figcaption span {
    display: grid;
  }
  .guia-relacionado {
    padding-bottom: var(--espaco-xl);
  }
  @media (min-width: 60rem) {
    /* dois por linha, com larguras desiguais alternadas */
    .vitrine__lista > :global(.trabalho:nth-child(4n + 1)) {
      grid-column: 1 / 8;
    }
    .vitrine__lista > :global(.trabalho:nth-child(4n + 2)) {
      grid-column: 8 / 13;
      align-self: end;
    }
    .vitrine__lista > :global(.trabalho:nth-child(4n + 3)) {
      grid-column: 1 / 6;
    }
    .vitrine__lista > :global(.trabalho:nth-child(4n + 4)) {
      grid-column: 6 / 13;
    }
  }
</style>
