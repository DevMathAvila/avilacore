---
import Base from '../layouts/Base.astro';
import Quadro from '../components/Quadro.astro';
import ArteFrente from '../components/ArteFrente.astro';
import MidiaQuadro from '../components/MidiaQuadro.astro';
import Processo from '../components/Processo.astro';
import CartaoTrabalho from '../components/CartaoTrabalho.astro';
import Fechamento from '../components/Fechamento.astro';
import { site, processo, type Frente } from '../config/site';
import { servicos, trabalhosPublicados } from '../lib/conteudo';

const titulo = 'AvilaCore · Vídeo, drone e sites em Indaiatuba';
const descricao =
  'Matheus Ávila grava e edita vídeos, faz imagens aéreas com drone em Indaiatuba e região e cria sites para todo o Brasil. Conte sua ideia.';

const frentes = await servicos();
const trabalhos = await trabalhosPublicados();
const destaque = (f: Frente) => trabalhos.find((t) => t.data.frente === f);
const temReal = trabalhos.some((t) => t.data.tipo === 'real');
/** na home, um trabalho de cada frente que já tem algo publicado (no máximo dois) */
const vitrine = (['audiovisual', 'drone', 'sites'] as Frente[])
  .map(destaque)
  .filter((t) => t !== undefined)
  .slice(0, 2);

/** proporção da moldura de cada frente: o formato do próprio meio */
const formato: Record<Frente, string> = { audiovisual: '9:16', drone: '16:9', sites: '16:10' };
const ancora: Record<Frente, string> = {
  audiovisual: 'Ver produção de vídeo',
  drone: 'Ver filmagem com drone',
  sites: 'Ver criação de sites',
};

const situacoes = [
  {
    titulo: 'Um imóvel que precisa ser visto do alto.',
    texto: 'A imagem aérea mostra o terreno inteiro, o acesso e o que existe em volta.',
    href: '/drone',
    rotulo: 'Filmagem com drone',
  },
  {
    titulo: 'Uma marca que precisa de vídeos para o Instagram.',
    texto: 'Gravo e edito no formato vertical, pronto para publicar.',
    href: '/audiovisual',
    rotulo: 'Produção de vídeo',
  },
  {
    titulo: 'Um evento que merece mais do que foto de celular.',
    texto: 'Vídeo de perto e imagem do alto do mesmo dia, com a mesma edição.',
    href: '/audiovisual',
    rotulo: 'Produção de vídeo',
  },
  {
    titulo: 'Um negócio que ainda não tem site.',
    texto: 'Um site que explica o que você faz e leva a pessoa até o seu WhatsApp.',
    href: '/sites',
    rotulo: 'Criação de sites',
  },
];
---

<Base titulo={titulo} descricao={descricao}>
  <section class="hero moldura">
    <svg class="hero__tercos" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M33.33 0V100M66.67 0V100M0 33.33H100M0 66.67H100" vector-effect="non-scaling-stroke"></path>
    </svg>

    <div class="hero__voo" aria-hidden="true">
      <svg class="hero__rota hero__rota--larga" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M0 94C34 94 58 86 70 66S86 34 90 20" vector-effect="non-scaling-stroke"></path>
      </svg>
      <svg class="hero__rota hero__rota--estreita" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M0 90C30 88 52 70 66 52S86 26 90 12" vector-effect="non-scaling-stroke"></path>
      </svg>
      <i class="hero__passagem hero__passagem--1"></i>
      <i class="hero__passagem hero__passagem--2"></i>
      <i class="hero__chegada"></i>
    </div>

    <div class="grade hero__conteudo">
      <h1>Vídeo, imagem aérea e sites para quem precisa ser visto.</h1>
      <p class="eixo-b hero__lead">
        Sou Matheus Ávila. Gravo e edito vídeos, voo com drone em Indaiatuba e região e crio sites
        para todo o&nbsp;Brasil.
      </p>
      <div class="eixo-b acoes hero__acoes">
        <a class="botao botao--acao" href="/contato">Conte sua ideia</a>
        <a class="link" href="#como-funciona">Ver como funciona</a>
      </div>
    </div>

    <p class="hero__coord numeros pequeno">
      <span>{site.coordenadas.lat}</span>
      <span>{site.coordenadas.lon}</span>
      <span class="apoio">{site.cidade}, {site.uf}</span>
    </p>
  </section>

  <section class="secao frentes" aria-labelledby="t-frentes">
    <div class="grade">
      <h2 id="t-frentes">O que eu faço</h2>
      <p class="eixo-b apoio frentes__intro">
        Três frentes que se ajudam: o vídeo que mostra o seu trabalho, a imagem aérea que mostra o
        lugar e o site que reúne tudo.
      </p>
    </div>
    <div class="grade frentes__lista">
      {
        frentes.map((f) => {
          const t = destaque(f.data.frente);
          return (
            <article class={`frente frente--${f.data.frente}`}>
              <Quadro proporcao={formato[f.data.frente]}>
                {t ? (
                  <MidiaQuadro trabalho={t} widths={[360, 520, 720, 960]} sizes="(min-width: 60rem) 40vw, 90vw" />
                ) : (
                  <ArteFrente frente={f.data.frente} />
                )}
              </Quadro>
              <div class="frente__texto">
                <h3>{f.data.nome}</h3>
                <p class="apoio">{f.data.resumo}</p>
                {t && (
                  <p class="pequeno apoio">
                    Na moldura: {t.data.titulo}, {t.data.tipo === 'estudo' ? 'estudo autoral' : 'trabalho para cliente'}.
                  </p>
                )}
                <a class="link" href={`/${f.data.frente}`}>{ancora[f.data.frente]}</a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="secao situacoes" aria-labelledby="t-situacoes">
    <div class="grade">
      <h2 id="t-situacoes">Quando faz sentido me&nbsp;chamar</h2>
      <ul role="list" class="situacoes__lista">
        {
          situacoes.map((s) => (
            <li>
              <h3>{s.titulo}</h3>
              <p class="apoio">{s.texto}</p>
              <a class="link" href={s.href}>{s.rotulo}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="secao" id="como-funciona" aria-labelledby="t-processo">
    <div class="grade">
      <h2 id="t-processo">Como funciona</h2>
      <p class="eixo-b apoio">
        O caminho é o mesmo nas três frentes. Você fala comigo em todas as etapas.
      </p>
      <div class="processo-home"><Processo passos={processo} /></div>
    </div>
  </section>

  <section class="secao trabalhos-home" aria-labelledby="t-trabalhos">
    <div class="grade">
      <h2 id="t-trabalhos">Trabalhos</h2>
      {
        trabalhos.length > 0 ? (
          <p class="eixo-b apoio">
            {
              temReal
                ? 'O portfólio está crescendo. Aqui entram vídeos feitos para clientes e estudos autorais, como tomadas aéreas e sites para marcas fictícias. Cada um aparece identificado.'
                : 'O portfólio está crescendo. Por enquanto, o que você vê aqui são estudos autorais: tomadas aéreas que gravei por conta própria e sites que criei para marcas fictícias.'
            }
          </p>
        ) : (
          <p class="eixo-b apoio">
            O portfólio está crescendo, e os trabalhos entram aqui conforme forem publicados, com
            crédito e contexto. Se quiser ver material antes disso, me chame no WhatsApp.
          </p>
        )
      }
    </div>
    {
      trabalhos.length > 0 && (
        <div class="grade trabalhos-home__lista">
          {vitrine.map((t) => <CartaoTrabalho trabalho={t} />)}
          <p class="trabalhos-home__todos">
            <a class="link" href="/trabalhos">Ver todos os trabalhos e estudos</a>
          </p>
        </div>
      )
    }
  </section>

  <Fechamento titulo="Vamos conversar sobre a sua ideia." />
</Base>

<style>
  /* ---------- Primeira tela: o visor ---------- */
  .hero {
    --recuo: clamp(0.6rem, 1.6vw, 1.25rem);
    --voo: 11rem; /* faixa da trajetória no celular */
    position: relative;
    display: grid;
    align-content: start;
    min-height: calc(100svh - var(--cabecalho));
    padding-block: var(--espaco-xl) calc(var(--voo) + 3.5rem);
    overflow: hidden;
  }
  .hero__tercos,
  .hero__rota {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__tercos path {
    fill: none;
    stroke: var(--linha);
    stroke-width: 1;
  }
  .hero__voo {
    position: absolute;
    inset: auto 0 0;
    height: var(--voo);
  }
  .hero__rota path {
    fill: none;
    stroke: var(--ciano);
    stroke-opacity: 0.75;
    stroke-width: 1.5;
    stroke-dasharray: 5 7;
  }
  .hero__rota--larga {
    display: none;
  }
  .hero__passagem,
  .hero__chegada {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 0.4rem;
    height: 0.4rem;
    background: var(--papel);
    opacity: 0.75;
    transform: translate(-50%, -50%);
  }
  .hero__chegada {
    --x: 90%;
    --y: 12%;
    width: 0.85rem;
    height: 0.85rem;
    background: var(--ciano);
    opacity: 1;
  }
  .hero__passagem--1 {
    --x: 39%;
    --y: 77%;
  }
  .hero__passagem--2 {
    --x: 66%;
    --y: 52%;
  }
  .hero__coord {
    position: absolute;
    right: 15%;
    bottom: calc(var(--voo) * 0.88 - 0.55rem);
    display: grid;
    max-width: none;
    line-height: 1.3;
    font-weight: 520;
    text-align: right;
  }
  .hero__conteudo {
    position: relative;
    row-gap: 0;
  }
  .hero h1 {
    font-size: clamp(2.05rem, 1.05rem + 5vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    font-weight: 800;
  }
  .hero__lead {
    margin-top: var(--espaco-m);
    color: var(--texto-apoio);
    max-width: 34ch;
  }
  .hero__acoes {
    margin-top: var(--espaco-m);
  }

  @media (min-width: 48rem) and (max-width: 59.99rem) {
    .hero {
      min-height: 0;
    }
  }
  @media (min-width: 60rem) {
    .hero {
      align-content: center;
      min-height: max(calc(100svh - var(--cabecalho)), 40rem);
      padding-block: var(--espaco-xl) 14vh;
    }
    .hero__voo {
      inset: 0;
      height: auto;
    }
    .hero__rota--larga {
      display: block;
    }
    .hero__rota--estreita {
      display: none;
    }
    .hero__passagem--1 {
      --x: 43.25%;
      --y: 87.5%;
    }
    .hero__passagem--2 {
      --x: 70%;
      --y: 66%;
    }
    .hero__chegada {
      --x: 90%;
      --y: 20%;
    }
    .hero__coord {
      right: 11.5%;
      top: 20%;
      bottom: auto;
      transform: translateY(-50%);
    }
    .hero h1 {
      grid-column: 1 / 10;
    }
    .hero__conteudo > .hero__lead,
    .hero__conteudo > .hero__acoes {
      grid-column: 3 / 9;
    }
    .hero__lead {
      max-width: 44ch;
    }
  }

  /* O único momento orquestrado do site: o foco fecha, o título sobe, a rota aparece */
  @media (prefers-reduced-motion: no-preference) {
    .hero::before {
      animation: foco-a var(--dur-3) var(--curva) both;
    }
    .hero::after {
      animation: foco-b var(--dur-3) var(--curva) both;
    }
    /* o título só desliza (sem sumir), para ser pintado já no primeiro quadro */
    .hero h1 {
      animation: desliza 560ms var(--curva) both;
    }
    .hero__lead {
      animation: sobe 560ms var(--curva) 120ms both;
    }
    .hero__acoes {
      animation: sobe 560ms var(--curva) 200ms both;
    }
    .hero__rota {
      animation: surge 700ms var(--curva) 320ms both;
    }
    .hero__passagem--1 {
      animation: ponto 380ms var(--curva) 520ms both;
    }
    .hero__passagem--2 {
      animation: ponto 380ms var(--curva) 640ms both;
    }
    .hero__chegada {
      animation: ponto 420ms var(--curva) 760ms both;
    }
    .hero__coord {
      animation: surge 500ms var(--curva) 860ms both;
    }
  }
  @keyframes foco-a {
    from {
      opacity: 0;
      transform: translate(-1rem, -1rem);
    }
  }
  @keyframes foco-b {
    from {
      opacity: 0;
      transform: translate(1rem, 1rem);
    }
  }
  @keyframes sobe {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  @keyframes desliza {
    from {
      transform: translateY(0.75rem);
    }
  }
  @keyframes surge {
    from {
      opacity: 0;
    }
  }
  @keyframes ponto {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0);
    }
  }

  /* ---------- As três frentes: cada moldura na proporção do seu meio ---------- */
  .frentes__intro {
    margin-top: var(--espaco-s);
  }
  .frentes__lista {
    margin-top: var(--espaco-xl);
    row-gap: var(--espaco-xl);
  }
  .frente {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--espaco-s);
  }
  .frente > :global(.quadro) {
    grid-column: 1 / -1;
  }
  .frente__texto {
    grid-column: 2 / -1;
  }
  .frente--audiovisual > :global(.quadro) {
    grid-column: 1 / 3;
  }
  .frente--audiovisual .frente__texto {
    grid-column: 3 / -1;
    align-self: end;
  }
  .frente h3 {
    font-size: var(--passo-2);
  }
  /* ao lado da moldura vertical a coluna é estreita: o nome precisa caber sem quebrar */
  .frente--audiovisual h3 {
    font-size: clamp(1.15rem, 6vw, 1.55rem);
    font-stretch: 100%;
  }
  .frente__texto p {
    margin-top: var(--espaco-2xs);
  }
  .frente__texto .link {
    margin-top: var(--espaco-2xs);
  }

  @media (min-width: 48rem) {
    .frente__texto {
      grid-column: 5 / 12;
    }
    .frente--audiovisual > :global(.quadro) {
      grid-column: 1 / 5;
    }
    .frente--audiovisual .frente__texto {
      grid-column: 6 / 12;
    }
    .frente--audiovisual h3 {
      font-size: var(--passo-2);
      font-stretch: var(--largura-titulo);
    }
  }
  @media (min-width: 60rem) {
    .frentes__lista {
      grid-template-rows: auto auto;
      row-gap: var(--espaco-s);
    }
    .frente {
      grid-row: 1 / span 2;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: subgrid;
    }
    .frente > :global(.quadro),
    .frente--audiovisual > :global(.quadro) {
      grid-column: 1;
      align-self: end;
    }
    .frente__texto,
    .frente--audiovisual .frente__texto {
      grid-column: 1;
      align-self: start;
    }
    .frentes__lista > .frente--audiovisual {
      grid-column: 1 / 4;
    }
    .frentes__lista > .frente--drone {
      grid-column: 4 / 9;
    }
    .frentes__lista > .frente--sites {
      grid-column: 9 / 13;
    }
  }

  /* ---------- Situações ---------- */
  .situacoes__lista {
    margin-top: var(--espaco-l);
    border-top: var(--traco) solid var(--linha);
  }
  .situacoes__lista li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block: var(--espaco-m) var(--espaco-xs);
    border-bottom: var(--traco) solid var(--linha);
  }
  .situacoes__lista h3 {
    font-size: var(--passo-2);
    max-width: 22ch;
  }
  .situacoes__lista p {
    margin-top: var(--espaco-2xs);
  }
  .situacoes__lista .link {
    justify-self: end;
  }
  @media (min-width: 48rem) {
    .situacoes h2 {
      grid-column: 1 / 5;
      align-self: start;
      position: sticky;
      top: calc(var(--cabecalho) + var(--espaco-m));
      font-size: var(--passo-3);
    }
    .situacoes__lista {
      grid-column: 5 / 13;
      margin-top: 0;
    }
    .situacoes__lista li {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--calha);
      align-items: end;
      padding-block: var(--espaco-m);
    }
    .situacoes__lista h3,
    .situacoes__lista p {
      grid-column: 1;
    }
    .situacoes__lista .link {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  /* ---------- Processo e trabalhos ---------- */
  .processo-home {
    margin-top: var(--espaco-l);
  }
  #como-funciona .eixo-b,
  .trabalhos-home .eixo-b {
    margin-top: var(--espaco-s);
  }
  .trabalhos-home__lista {
    margin-top: var(--espaco-l);
    row-gap: var(--espaco-xl);
  }
  .trabalhos-home__todos {
    max-width: none;
  }
  @media (min-width: 60rem) {
    .trabalhos-home__lista > :global(.trabalho:nth-child(1)) {
      grid-column: 1 / 8;
    }
    .trabalhos-home__lista > :global(.trabalho:nth-child(2)) {
      grid-column: 8 / 13;
      align-self: end;
    }
  }
</style>
