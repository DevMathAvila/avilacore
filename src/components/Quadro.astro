---
/**
 * Moldura de mídia na proporção do formato (9:16, 16:9, 16:10...), com os dois cantos do Foco.
 * O conteúdo (imagem, vídeo ou arte) preenche a moldura inteira.
 */
import { razao } from '../lib/conteudo';
interface Props {
  proporcao: string;
  class?: string;
}
const { proporcao, class: classe } = Astro.props;
---

<div class:list={['quadro', 'moldura', classe]} style={`aspect-ratio: ${razao(proporcao)}`}>
  <slot />
</div>

<style>
  .quadro {
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background: var(--noite-2);
    border: var(--traco) solid var(--linha);
    border-radius: var(--raio-0);
  }
  .quadro > :global(img),
  .quadro > :global(picture),
  .quadro > :global(picture img),
  .quadro > :global(svg),
  .quadro > :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
</style>
