---
interface Props {
  title: string;
  descricao: string;
  domain: string;
  url: string;
  mode?: 'live' | 'image';
  image?: string;
}
const { title, descricao, domain, url, mode = 'live', image } = Astro.props;
---

<figure class="case">
  <div class="browser">
    <div class="chrome">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="addr">{domain}</span>
      <a class="visit" href={url} target="_blank" rel="noopener">
        visitar site
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
      </a>
    </div>

    <div class="screen" data-screen>
      {mode === 'live' ? (
        <>
          <iframe
            class="frame"
            data-frame
            data-src={url}
            title={`Prévia do site de ${title}`}
            loading="lazy"
            referrerpolicy="no-referrer"
          ></iframe>
          <button class="explore" data-explore type="button">
            clique para explorar
          </button>
        </>
      ) : image ? (
        <a href={url} target="_blank" rel="noopener" class="shot">
          <img src={image} alt={`Site de ${title}`} loading="lazy" />
        </a>
      ) : (
        <a href={url} target="_blank" rel="noopener" class="placeholder">
          <span class="placeholder__domain">{domain}</span>
          <span class="placeholder__cta">visitar site</span>
        </a>
      )}
    </div>
  </div>

  <figcaption class="caption">
    <h3 class="caption__name">{title}</h3>
    <p class="caption__desc">{descricao}</p>
  </figcaption>
</figure>

<style>
  .case {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .browser {
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: #0f0c0a;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 0.95rem;
    background: var(--card);
    border-bottom: 1px solid var(--line);
  }
  .dots {
    display: inline-flex;
    gap: 6px;
    flex: 0 0 auto;
  }
  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--muted) 45%, transparent);
  }
  .addr {
    flex: 1;
    min-width: 0;
    font-size: 0.85rem;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 0.3rem 0.85rem;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .visit {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--accent);
    transition: color 0.2s var(--ease);
  }
  .visit:hover {
    color: var(--accent-strong);
  }

  .screen {
    position: relative;
    width: 100%;
    aspect-ratio: 1440 / 900;
    overflow: hidden;
    background: #0f0c0a;
  }
  .frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 1440px;
    height: 900px;
    border: 0;
    transform-origin: top left;
    transform: scale(var(--s, 0.3));
    pointer-events: none;
  }
  .screen[data-active='true'] .frame {
    pointer-events: auto;
  }
  .explore {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 1.2rem;
    background: linear-gradient(
      to top,
      rgba(15, 12, 10, 0.55),
      transparent 45%
    );
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    border: 0;
    cursor: pointer;
    transition: opacity 0.25s var(--ease);
  }
  .screen[data-active='true'] .explore {
    opacity: 0;
    pointer-events: none;
  }

  .shot,
  .placeholder {
    position: absolute;
    inset: 0;
    display: flex;
  }
  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .placeholder {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background:
      radial-gradient(90% 90% at 50% 0%, rgba(216, 121, 74, 0.12), transparent 60%),
      #0f0c0a;
  }
  .placeholder__domain {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .placeholder__cta {
    font-size: 0.9rem;
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
  }

  .caption__name {
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .caption__desc {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
  }
</style>

<script>
  const cases = document.querySelectorAll<HTMLElement>('[data-screen]');

  const setScale = (screen: HTMLElement) => {
    const frame = screen.querySelector<HTMLElement>('[data-frame]');
    if (!frame) return;
    screen.style.setProperty('--s', String(screen.clientWidth / 1440));
  };

  const loadFrame = (screen: Element) => {
    const frame = screen.querySelector<HTMLIFrameElement>('[data-frame]');
    if (frame && !frame.src && frame.dataset.src) {
      frame.src = frame.dataset.src;
    }
  };

  // Carrega o iframe quando entra na tela (performance)
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        loadFrame(e.target);
        io.unobserve(e.target);
      });
    },
    { rootMargin: '300px' }
  );

  cases.forEach((screen) => {
    if (screen.querySelector('[data-frame]')) io.observe(screen);

    const explore = screen.querySelector('[data-explore]');
    explore?.addEventListener('click', () => {
      screen.setAttribute('data-active', 'true');
    });
  });

  // Mede depois do layout (a Mayara ocupa a largura cheia) e a cada resize
  const applyScales = () => cases.forEach(setScale);
  applyScales();
  requestAnimationFrame(() => requestAnimationFrame(applyScales));
  window.addEventListener('resize', applyScales, { passive: true });

  // Garante que as prévias carreguem mesmo se o observer não disparar
  window.addEventListener('load', () => {
    applyScales();
    cases.forEach(loadFrame);
  });
</script>
