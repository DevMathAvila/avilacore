---
/**
 * Prévia silenciosa dentro de uma moldura: toca em loop, sem som, só enquanto está visível.
 * A capa (slot, com o texto alternativo) fica à mostra até o vídeo começar; o arquivo só é baixado quando a
 * moldura entra na tela. Tem botão de pausa (WCAG 2.2.2) e, com prefers-reduced-motion,
 * fica parada na capa até a pessoa tocar.
 */
interface Props {
  /** caminho do vídeo curto em /public (mp4 leve, sem áudio) */
  src: string;
}
const { src } = Astro.props;
---

<div class="previa" data-previa>
  <slot />
  <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" disablepictureinpicture>
    <source src={src} type={src.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
  </video>
  <button type="button" class="previa__botao" data-previa-botao>Tocar vídeo</button>
</div>

<script>
  const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-previa]').forEach((caixa) => {
    const video = caixa.querySelector('video');
    const botao = caixa.querySelector<HTMLButtonElement>('[data-previa-botao]');
    if (!video || !botao) return;
    let pausadoPelaPessoa = semMovimento.matches;

    const atualizar = () => {
      botao.textContent = video.paused ? 'Tocar vídeo' : 'Pausar vídeo';
    };
    const tocar = () => video.play().then(atualizar, atualizar);
    video.addEventListener('playing', () => caixa.setAttribute('data-tocando', ''), { once: true });
    atualizar();

    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting && !pausadoPelaPessoa) tocar();
        else {
          video.pause();
          atualizar();
        }
      },
      { threshold: 0.4 },
    ).observe(caixa);

    botao.addEventListener('click', () => {
      if (video.paused) {
        pausadoPelaPessoa = false;
        tocar();
      } else {
        pausadoPelaPessoa = true;
        video.pause();
        atualizar();
      }
    });
  });
</script>

<style>
  .previa {
    position: absolute;
    inset: 0;
  }
  .previa :global(picture),
  .previa :global(img),
  .previa video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* o vídeo fica transparente sobre a capa até começar a tocar */
  .previa video {
    opacity: 0;
    transition: opacity var(--dur-3) var(--curva);
  }
  .previa[data-tocando] video {
    opacity: 1;
  }
  .previa__botao {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    z-index: 3;
    min-width: var(--toque);
    min-height: var(--toque);
    padding: 0 0.9rem;
    background: var(--noite);
    border: var(--traco) solid var(--borda);
    border-radius: var(--raio-1);
    font-size: var(--passo--1);
    font-weight: var(--peso-forte);
    cursor: pointer;
  }
  .previa__botao:hover {
    border-color: var(--papel);
  }
</style>
