---
/** Dúvidas em <details>: abre por teclado e toque, sem JavaScript. */
interface Props {
  itens: { pergunta: string; resposta: string }[];
}
const { itens } = Astro.props;
---

<div class="duvidas">
  {
    itens.map((d) => (
      <details>
        <summary>
          <span>{d.pergunta}</span>
          <span class="duvidas__sinal" aria-hidden="true" />
        </summary>
        <div class="duvidas__resposta">
          <slot name={d.pergunta}>
            <p>{d.resposta}</p>
          </slot>
        </div>
      </details>
    ))
  }
</div>

<style>
  .duvidas {
    border-top: var(--traco) solid var(--linha);
  }
  details {
    border-bottom: var(--traco) solid var(--linha);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espaco-s);
    min-height: 3.75rem;
    padding-block: var(--espaco-xs);
    font-size: var(--passo-1);
    font-weight: 650;
    line-height: 1.25;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--ciano);
  }
  /* sinal de mais desenhado com duas barras; a vertical some ao abrir */
  .duvidas__sinal {
    position: relative;
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
  }
  .duvidas__sinal::before,
  .duvidas__sinal::after {
    content: '';
    position: absolute;
    left: 0;
    top: calc(50% - 1px);
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: transform var(--dur-2) var(--curva);
  }
  .duvidas__sinal::after {
    transform: rotate(90deg);
  }
  details[open] .duvidas__sinal::after {
    transform: rotate(0deg);
  }
  .duvidas__resposta {
    padding-bottom: var(--espaco-m);
    color: var(--texto-apoio);
  }
  .duvidas__resposta :global(p) {
    max-width: 60ch;
  }
  .duvidas__resposta :global(p + p) {
    margin-top: var(--espaco-2xs);
  }
</style>
